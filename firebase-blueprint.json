{
  "entities": {
    "StaffMember": {
      "title": "StaffMember",
      "description": "Front desk staff member profile, unique login ID, and monthly/daily goals.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique staff document identifier"
        },
        "staffLoginId": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32,
          "pattern": "^AUR-[a-zA-Z0-9_\\-]+$",
          "description": "Unique staff login ID starting with AUR- (e.g. AUR-101)"
        },
        "staffName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Staff member display name"
        },
        "role": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Front desk role title"
        },
        "avatarColor": {
          "type": "string",
          "minLength": 4,
          "maxLength": 16,
          "description": "Hex color code for staff avatar"
        },
        "monthlyGoal": {
          "type": "integer",
          "description": "Target monthly approved rewards count"
        },
        "dailyGoal": {
          "type": "integer",
          "description": "Target daily approved rewards count"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "description": "Shared office workspace identifier (aurelia-office)"
        }
      },
      "required": [
        "id",
        "staffLoginId",
        "staffName",
        "role",
        "avatarColor",
        "monthlyGoal",
        "dailyGoal",
        "workspaceId"
      ]
    },
    "RewardEntry": {
      "title": "RewardEntry",
      "description": "Daily guest rewards number entry logged by a staff member and subject to manager approval.",
      "type": "object",
      "properties": {
        "entryId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique entry identifier"
        },
        "staffId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "ID of the staff member who recorded this entry"
        },
        "reservationNumber": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Guest reservation number (alphanumeric/hyphens only)"
        },
        "rewardsNumber": {
          "type": "string",
          "minLength": 16,
          "maxLength": 16,
          "pattern": "^[0-9]{16}$",
          "description": "Exact 16-digit guest rewards number (e.g. 6015995107986345)"
        },
        "dateIso": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Enrollment date YYYY-MM-DD"
        },
        "timestamp": {
          "type": "string",
          "minLength": 5,
          "maxLength": 12,
          "description": "Submission time HH:MM:SS"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "approved", "rejected"],
          "description": "Manager approval status"
        },
        "reviewedBy": {
          "type": "string",
          "maxLength": 100,
          "description": "Reviewer role identifier (e.g. MANAGER)"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "description": "Shared office workspace identifier (aurelia-office)"
        }
      },
      "required": [
        "entryId",
        "staffId",
        "reservationNumber",
        "rewardsNumber",
        "dateIso",
        "timestamp",
        "status",
        "workspaceId"
      ]
    },
    "OfficeConfig": {
      "title": "OfficeConfig",
      "description": "Global office configuration storing the SHA-256 salted hash of the manager password.",
      "type": "object",
      "properties": {
        "workspaceId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "description": "Shared office workspace identifier (aurelia-office)"
        },
        "managerPasswordHash": {
          "type": "string",
          "minLength": 64,
          "maxLength": 64,
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 salted cryptographic hash of the manager password (never plaintext)"
        },
        "initialized": {
          "type": "boolean",
          "description": "Whether initial staff roster has been seeded"
        }
      },
      "required": ["workspaceId", "managerPasswordHash", "initialized"]
    },
    "ActiveSession": {
      "title": "ActiveSession",
      "description": "Real-time record of a user currently signed in on a workstation.",
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "Unique workstation session identifier"
        },
        "role": {
          "type": "string",
          "enum": ["staff", "manager"],
          "description": "Role of the signed-in user"
        },
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "description": "Staff ID (e.g. STF-01) or 'MANAGER'"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80,
          "description": "Staff member name or 'Manager'"
        },
        "loginIdentifier": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80,
          "description": "Staff Login ID (e.g. AUR-101) or 'MANAGER'"
        },
        "signedInAt": {
          "type": "string",
          "minLength": 5,
          "maxLength": 32,
          "description": "Human-readable sign-in time"
        },
        "workspaceId": {
          "type": "string",
          "minLength": 4,
          "maxLength": 32,
          "description": "Shared office workspace identifier (aurelia-office)"
        }
      },
      "required": [
        "sessionId",
        "role",
        "userId",
        "displayName",
        "loginIdentifier",
        "signedInAt",
        "workspaceId"
      ]
    }
  },
  "firestore": {
    "/staff_members/{staffId}": {
      "schema": { "$ref": "#/entities/StaffMember" },
      "description": "Front desk staff members across workstations"
    },
    "/reward_entries/{entryId}": {
      "schema": { "$ref": "#/entities/RewardEntry" },
      "description": "All daily guest reward entries across all staff and dates"
    },
    "/office_config/{configId}": {
      "schema": { "$ref": "#/entities/OfficeConfig" },
      "description": "Office configuration document (configId = 'main')"
    },
    "/active_sessions/{sessionId}": {
      "schema": { "$ref": "#/entities/ActiveSession" },
      "description": "Users currently signed in across workstations"
    }
  }
}
